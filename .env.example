# Copier vers .env et adapter en production
POSTGRES_USER=entomo
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=entomo
API_PORT=8000
FRONTEND_PORT=8080

# Backend
SECRET_KEY=generate-with-python-secrets-token-urlsafe-32
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg2://entomo:change-me-strong-password@localhost:5432/entomo
CORS_ORIGINS=https://entomo.example.gov.sn

# Assistant (optionnel)
ASSISTANT_PROVIDER=rules
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DHIS2 (exemple)
DHIS2_DEFAULT_URL=
